/* MANAGED BY ANSIBLE */
:root {
    --phosphor-bright: #cbd5e1;
    --phosphor-dim: rgba(203, 213, 225, 0.5);
    --crt-glow: rgba(255, 255, 255, 0.05);
}

body {
    text-shadow: 0 0 2px var(--phosphor-dim), 0 0 5px var(--crt-glow) !important;
}

.scanlines {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(
        to bottom,
        rgba(18, 16, 16, 0) 50%,
        rgba(0, 0, 0, 0.15) 50%
    );
    background-size: 100% 3px;
    pointer-events: none;
    z-index: 9999;
}

.screen-flicker {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(255, 255, 255, 0.01);
    z-index: 9998;
    pointer-events: none;
    animation: flicker 0.12s infinite;
}

@keyframes flicker {
    0% { opacity: 0.1; }
    50% { opacity: 0.2; }
    100% { opacity: 0.1; }
}

.bezel {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    box-shadow: inset 0 0 20vw rgba(0, 0, 0, 0.6);
    pointer-events: none;
    z-index: 9997;
}

.information-widget-greeting span, .service-name {
    letter-spacing: 0.05em !important;
}

.primary-text, .information-widget-greeting span {
    filter: drop-shadow(0 0 3px var(--phosphor-dim)) !important;
}

#information-widgets {
    background-image: url('https://w.wallhaven.cc/full/4g/wallhaven-4grexl.jpg') !important;
    background-size: cover !important;
    background-position: center 45% !important;
    border: 2px solid rgba(255, 255, 255, 0.1) !important;
    position: relative !important;
    overflow: hidden !important;
    min-height: 120px;
}

#information-widgets::before {
    content: "" !important;
    position: absolute !important;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.6) !important;
    z-index: 1;
}

#widgets-wrap {
    position: relative !important;
    z-index: 2 !important;
}

.information-widget-greeting span {
    font-family: 'Courier New', Courier, monospace !important;
    font-weight: bold !important;
    font-size: 1.4rem !important;
    color: #ffffff !important;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.9) !important;
}

.information-widget-datetime span,
.information-widget-openmeteo span {
    color: #ffffff !important;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9) !important;
}

.information-widget-search input {
    background-color: rgba(255, 255, 255, 0.1) !important;
    backdrop-filter: blur(4px) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    color: white !important;
}

.information-widget-greeting span {
    font-family: 'Courier New', Courier, monospace !important;
    font-size: 0.8rem !important;
    color: white !important;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8) !important;
    font-style: italic !important;
}

.information-widget-greeting {
    max-width: none !important;
    width: auto !important;
}

.service-group {
    background-color: rgba(15, 23, 42, 0.3) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    border-radius: 1rem !important;
    padding: 1.25rem !important;
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4) !important;
}

.service-card {
    background-color: rgba(5, 5, 5, 0.45) !important;
    border: 1px solid rgba(255, 255, 255, 0.25) !important;
    transition: all 0.3s ease !important;
}

.service-card:hover {
    background-color: rgba(255, 255, 255, 0.15) !important;
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.35) !important;
}

.service-name {
    color: #f8fafc !important;
    font-weight: 600 !important;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5) !important;
}

.service-description {
    color: #cbd5e1 !important;
    text-shadow: 0 1px 2px rgba(0,0,0,0.5) !important;
}

.bookmark {
    display: flex;
    align-items: left;
    background-color: rgba(5, 5, 5, 0.75) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    transition: all 0.3s ease !important;
    border-radius: var(--radius-md);
    margin-bottom: 3px;
}

.bookmark:hover {
    background-color: rgba(255, 255, 255, 0.15) !important;
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.35) !important;
}

.bookmark-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex-grow: 1;
    margin-bottom: 3px;
}

.bookmark-name {
    font-size: 0.85rem;
    font-style: bold;
    padding-bottom: 0px;
    line-height: 1;
}

.bookmark-description {
    font-size: 0.7rem;
    padding-left: 12px;
    line-height: 0.5;
    color: #cbd5e1 !important;
    text-shadow: 0 1px 2px rgba(0,0,0,0.5) !important;
    font-weight: 250;
}

.mb-3 {
    margin-bottom: 0px;
}
